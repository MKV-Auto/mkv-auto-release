# Copy to .venv/database_url.env (inside your Backend venv; .venv/ is gitignored).
# activate will source .venv/database_url.env only when DATABASE_URL is not already set.
#
# Postgres from Docker/docker-compose.dev.yml (service postgres, port 5432 on same machine):
DATABASE_URL=postgresql+psycopg2://postgres:changeme@127.0.0.1:5432/discs
#
# When `mkv` / dev Docker publishes Postgres on another host (example: ripper at 10.0.6.231):
# DATABASE_URL=postgresql+psycopg2://postgres:changeme@10.0.6.231:5432/discs
#
# Local Postgres matching api/database.py default (no env set):
# DATABASE_URL=postgresql+psycopg2://postgres:ripper_pass@localhost:5432/discs
#
# psycopg2 is optional in the URL; postgresql:// also works with SQLAlchemy.
